# Copy this file to ".env" and fill in your own values.
# One NAME=value per line: no spaces around "=", no quotes, no extra text.
# Never commit your real .env file.

# Any OpenAI-compatible endpoint (NVIDIA, Groq, OpenRouter, ...)
base_url=https://integrate.api.nvidia.com/v1

# Your API key for that provider
api_key=your_api_key_here

# Exact model name as listed by your provider.
# Pick a fast, non-reasoning model that is good at code.
MODEL=your_model_name_here
